{
  "name": "hexfactory",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ./factory-wasm --target web --out-dir pkg --out-name factory_wasm",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "lint": "eslint .",
    "format": "prettier --check . && cargo fmt --manifest-path factory-wasm/Cargo.toml -- --check",
    "format:write": "prettier --write . && cargo fmt --manifest-path factory-wasm/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rust": "cargo test --manifest-path factory-wasm/Cargo.toml",
    "audit": "npm audit --audit-level=high",
    "quality": "npm run audit && npm run format && npm run lint && npm run typecheck && npm run test:run && npm run test:rust && npm run build"
  },
  "dependencies": {
    "@hexlife/embed": "1.15.0"
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "@types/node": "24.13.3",
    "eslint": "9.30.0",
    "globals": "16.2.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  }
}
